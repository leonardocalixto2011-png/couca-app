// Couca & Co. Beauty — data model (Phase 1 scaffold).
// Booking engine, boutique, customer accounts + loyalty, plus Auth.js models.
// Migrations are deferred until DATABASE_URL points at a real Neon Postgres.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ----------------------------------------------------------------------------
// Catalogue
// ----------------------------------------------------------------------------

enum ServiceCategory {
  GEL_SET
  ADDON
}

model Service {
  id            String          @id @default(cuid())
  slug          String          @unique
  category      ServiceCategory
  nameFr        String
  nameEn        String
  descriptionFr String?
  descriptionEn String?
  priceCents    Int
  // durationMin: PLACEHOLDER — awaiting owner confirmation of real service times.
  durationMin   Int             @default(60)
  active        Boolean         @default(true)
  sortOrder     Int             @default(0)
  bookings      Booking[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model Product {
  id            String   @id @default(cuid())
  slug          String   @unique
  nameFr        String
  nameEn        String
  descriptionFr String?
  descriptionEn String?
  priceCents    Int
  images        Json     @default("[]") // string[] of image URLs
  // [{ nameFr, nameEn, values: [{ value, labelFr, labelEn }] }] — e.g. Krèm flavour
  options       Json     @default("[]")
  stock         Int? // null = not tracked
  active        Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ----------------------------------------------------------------------------
// Availability
// ----------------------------------------------------------------------------

model BusinessHours {
  id       String  @id @default(cuid())
  // 0 = Sunday … 6 = Saturday
  weekday  Int     @unique
  isOpen   Boolean @default(true)
  // minutes from midnight. Confirmed hours: 7 days a week, 13:00–18:00.
  openMin  Int     @default(780) // 13:00
  closeMin Int     @default(1080) // 18:00
}

model TimeOff {
  id        String   @id @default(cuid())
  startAt   DateTime
  endAt     DateTime
  reason    String?
  createdAt DateTime @default(now())
}

// ----------------------------------------------------------------------------
// Bookings
// ----------------------------------------------------------------------------

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

model Booking {
  id        String        @id @default(cuid())
  reference String        @unique @default(cuid())
  status    BookingStatus @default(PENDING)

  serviceId  String
  service    Service @relation(fields: [serviceId], references: [id])
  addonSlugs Json    @default("[]")

  startAt DateTime
  endAt   DateTime

  contactName  String
  contactEmail String
  contactPhone String?
  notes        String?
  // Reference photos the client attached at booking — string[] of Vercel Blob URLs
  inspoImages  Json    @default("[]")
  locale       String  @default("fr")

  estimatedTotalCents   Int?
  // $20 flat, non-refundable, applied to the final in-studio bill (see src/lib/policy.ts)
  depositCents          Int       @default(2000)
  depositPaid           Boolean   @default(false)
  depositForfeited      Boolean   @default(false)
  cancelledAt           DateTime?
  loyaltyCounted        Boolean   @default(false)
  stripePaymentIntentId String?
  // Set by the daily reminder cron once the day-before email has gone out
  reminderSentAt        DateTime?
  // Set by the daily cron once the day-after thank-you / review / rebook email has gone out
  followUpSentAt        DateTime?
  // Set once the "your spot is waiting, pay your deposit" email has gone out
  depositReminderSentAt DateTime?
  // Referral: code the new client used, the discount it gave, and when the referrer was credited
  referralCode          String?
  referralDiscountCents Int       @default(0)
  referralRewardedAt    DateTime?
  // "Time for your fill" nudge, ~18 days after a completed set
  rebookNudgeSentAt     DateTime?

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startAt])
  @@index([status])
}

// ----------------------------------------------------------------------------
// Customers + Couca Club loyalty
// ----------------------------------------------------------------------------

model Customer {
  id                  String         @id @default(cuid())
  email               String         @unique
  name                String?
  phone               String?
  locale              String         @default("fr")
  loyaltyVisits       Int            @default(0)
  // Personal referral code (e.g. LISE7K) and earned credit, applied in studio
  referralCode        String?        @unique
  referralCreditCents Int            @default(0)
  userId              String?        @unique
  user                User?          @relation(fields: [userId], references: [id])
  bookings            Booking[]
  loyaltyEvents       LoyaltyEvent[]
  orders              Order[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
}

model LoyaltyEvent {
  id          String    @id @default(cuid())
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id])
  visitNumber Int
  rewardKey   String // e.g. "club.r3.short"
  redeemedAt  DateTime?
  createdAt   DateTime  @default(now())
}

// ----------------------------------------------------------------------------
// Boutique orders
// ----------------------------------------------------------------------------

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  CANCELLED
  REFUNDED
}

model Order {
  id                      String      @id @default(cuid())
  reference               String      @unique @default(cuid())
  status                  OrderStatus @default(PENDING)
  contactEmail            String
  // [{ productId, slug, nameFr, nameEn, priceCents, qty, options: {name: value} }]
  items                   Json        @default("[]")
  subtotalCents           Int
  shippingJson            Json? // Stripe-collected shipping address
  locale                  String      @default("fr")
  stripeCheckoutSessionId String?
  customerId              String?
  customer                Customer?   @relation(fields: [customerId], references: [id])
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  @@index([status])
}

// ----------------------------------------------------------------------------
// Auth.js (v5) — Prisma adapter models
// ----------------------------------------------------------------------------

enum UserRole {
  CUSTOMER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(CUSTOMER)
  passwordHash  String? // set for ADMIN credentials login
  accounts      Account[]
  sessions      Session[]
  customer      Customer?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Clients who asked to be told when a spot frees up (calendar full or the day they wanted was taken).
model Waitlist {
  id          String    @id @default(cuid())
  name        String
  email       String
  phone       String?
  serviceSlug String?
  wantedDate  String?
  locale      String    @default("fr")
  notifiedAt  DateTime?
  closedAt    DateTime?
  createdAt   DateTime  @default(now())

  @@index([notifiedAt])
}
