# ── Copy to .env and fill in. Never commit .env. ──────────────────────────────

# Neon Postgres — pooled connection string for the app
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Direct (non-pooled) connection for `prisma migrate` — Neon provides this too
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth.js v5
AUTH_SECRET=""            # generate: npx auth secret
AUTH_URL="http://localhost:3000"

# Stripe (Phase 2 + 4)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Resend (Phase 2 — confirmation / receipt emails)
RESEND_API_KEY=""
EMAIL_FROM="Couca & Co. Beauty <bonjour@coucabeauty.ca>"

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
