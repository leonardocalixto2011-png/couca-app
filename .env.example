# ── Copy to .env and fill in. Never commit .env. ──────────────────────────────

# Neon Postgres — pooled connection string for the app
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Direct (non-pooled) connection for `prisma migrate` — Neon provides this too
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth.js v5
AUTH_SECRET=""            # generate: npx auth secret
AUTH_URL="http://localhost:3000"

# Admin login — seeded by `npm run db:seed`
ADMIN_EMAIL="you@coucabeauty.ca"
ADMIN_PASSWORD="a-strong-password"

# Stripe (Phase 2 + 4)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Resend (Phase 2 — confirmation / receipt emails)
RESEND_API_KEY=""
EMAIL_FROM="Couca & Co. Beauty <bonjour@coucabeauty.ca>"

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Added 2026-09-20 ─────────────────────────────────────────────────────────
# Owner notifications (new booking / new order). Comma-separated.
# Defaults to BRAND.email (the studio's Outlook inbox). Do NOT use admin@coucabeauty.ca:
# it has no Cloudflare forwarding rule, so alerts sent there are dropped.
OWNER_NOTIFY_EMAIL=""
# Optional short text alert via the carrier's email-to-SMS gateway, comma-separated.
# e.g. 4385054220@txt.bell.ca (Bell), @pcs.rogers.com (Rogers), @fido.ca (Fido),
# @texto.videotron.ca (Videotron), @txt.freedommobile.ca (Freedom), @msg.telus.com (Telus)
OWNER_SMS_EMAIL=""

# Inspo photo uploads at booking. Create a Blob store in Vercel → Storage → Blob
# and connect it to the project; Vercel injects this automatically.
BLOB_READ_WRITE_TOKEN=""

# Day-before reminder cron (vercel.json). Any long random string; Vercel sends it
# as "Authorization: Bearer …" when it calls /api/cron/reminders.
CRON_SECRET=""

# Google reviews on the homepage. Needs a Google Business Profile (can be a
# service-area business with the address hidden) + a Maps Platform key with
# "Places API (New)" enabled.
GOOGLE_PLACE_ID=""
GOOGLE_MAPS_API_KEY=""

# Google tag — GA4 + Google Ads conversion tracking. Site works without them.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""          # G-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_ID=""              # AW-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_BOOKING_LABEL=""   # conversion label for "Réservation"
NEXT_PUBLIC_GOOGLE_ADS_ORDER_LABEL=""     # conversion label for "Commande boutique"

# Google Business Profile "ask for a review" short link (from the profile's
# "Demander des avis" button). Shows the "Laisser un avis Google" CTA on the
# site without needing the Places API / a Maps key.
GOOGLE_REVIEW_URL=""
